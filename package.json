{
  "name": "syd-colombia",
  "private": true,
  "version": "2.10.2",
  "description": "SYD Colombia - Software de Cotizaciones y Licitaciones",
  "author": "SYD Colombia",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "node scripts/build.js",
    "start": "node server.ts",
    "lint": "tsc --noEmit",
    "electron:dev": "electron .",
    "desktop:build": "node scripts/build-desktop.js"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "alasql": "^4.19.0",
    "canvas-confetti": "^1.9.4",
    "docx": "^9.7.1",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.3.9",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "firebase": "^12.18.0",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^2.3.9",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^9.0.5",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sql.js": "^1.14.2",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sql.js": "^1.4.11",
    "autoprefixer": "^10.4.21",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "build": {
    "appId": "com.sydcolombia.app",
    "productName": "SYD Colombia",
    "copyright": "Copyright (c) 2026 SYD Colombia",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist-server/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "app/dist"
      },
      {
        "from": "public",
        "to": "app/public"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "eljemb22",
      "repo": "SYD-COLOMBIA-COTIZACIONES",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SYD Colombia",
      "artifactName": "SYD Colombia Setup ${version}.${ext}"
    },
    "portable": {
      "artifactName": "SYD Colombia Portable ${version}.${ext}"
    }
  }
}
